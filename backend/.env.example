DATABASE_URL="postgresql://apms_user:CHANGE_ME@127.0.0.1:5433/apms?schema=public"
JWT_SECRET="CHANGE_ME_min_32_bytes"
PORT=3001
NODE_ENV=development

# Both database clients use this pool size (up to twice this many connections).
DATABASE_POOL_SIZE=3
# Production defaults to verify-full. Use disable only for a private local DB.
# DATABASE_TLS_MODE=verify-full
# Absolute path to a provider CA, only when not trusted by the system.
# DATABASE_CA_FILE=/private/config/postgres-ca.pem
# Prisma CLI uses DATABASE_URL directly: require TLS and sslaccept=strict in its URL.

# Production is same-origin by default; list additional trusted origins if needed.
# CORS_ORIGINS=https://apms.sia-bendjemaa.com
# Configure only verified proxy IPs/CIDRs, separated by commas.
# TRUST_PROXY=127.0.0.1,::1
