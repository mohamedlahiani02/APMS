/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model analytics_stock_snapshot {
  annee           Int
  mois            Int
  produit_id      String       @db.Uuid
  magasin_id      String       @db.Uuid
  fournisseur_id  String       @db.Uuid
  famille_id      String       @db.Uuid
  qte_achetee     Decimal      @default(0) @db.Decimal(12, 3)
  qte_vendue      Decimal      @default(0) @db.Decimal(12, 3)
  total_achat_ttc Decimal      @default(0) @db.Decimal(14, 3)
  total_vente_ttc Decimal      @default(0) @db.Decimal(14, 3)
  cmup_mois       Decimal?     @db.Decimal(12, 3)
  qte_stock       Decimal      @db.Decimal(12, 3)
  cmup_cumule     Decimal?     @db.Decimal(12, 3)
  valeur_stock    Decimal      @db.Decimal(14, 3)
  nb_tx           Int          @default(0)
  statut          String       @default("VALIDE") @db.VarChar(20)
  derniere_maj    DateTime     @default(now()) @db.Timestamptz(6)
  qte_deficit     Decimal      @default(0) @db.Decimal(12, 3)
  familles        familles     @relation(fields: [famille_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fournisseurs    fournisseurs @relation(fields: [fournisseur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  magasins        magasins     @relation(fields: [magasin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produits        produits     @relation(fields: [produit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([annee, mois, produit_id, magasin_id, fournisseur_id])
  @@index([annee, mois, famille_id], map: "idx_snapshot_famille")
  @@index([annee, mois, fournisseur_id], map: "idx_snapshot_fournisseur")
  @@index([annee, mois, magasin_id], map: "idx_snapshot_magasin")
  @@index([annee, mois, produit_id], map: "idx_snapshot_produit")
}

